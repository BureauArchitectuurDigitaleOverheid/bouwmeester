{
  "name": "bouwmeester-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:update": "playwright test --update-snapshots",
    "validate:nldd": "node scripts/validate-nldd-markup.mjs && node scripts/validate-nldd-tokens.mjs && node scripts/validate-css-classes.mjs"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "^1.28.0",
    "@nldd/design-system": "^0.8.92",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-query": "^5.103.1",
    "@types/dagre": "^0.7.54",
    "dagre": "^0.8.5",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "lucide-react": "^1.47.0",
    "mermaid": "^12.0.0",
    "postal-mime": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "react-router-dom": "^7.18.4",
    "reactflow": "^11.11.4",
    "remark-gfm": "^4.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.28",
    "sirv": "^3.0.2",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "eslint-plugin-react-hooks": {
      "eslint": "$eslint"
    },
    "typescript-eslint": {
      "eslint": "$eslint"
    }
  }
}
